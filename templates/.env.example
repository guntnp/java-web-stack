# Copy to .env and fill in. .env is git-ignored: never commit it or paste its values anywhere.
# Make each secret with:  openssl rand -base64 32

DB_PASSWORD=
DB_ROOT_PASSWORD=

# First admin, created at startup when no admin exists yet (password: 12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production only (docker/compose.prod.yml): the token of the tunnel made in Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
